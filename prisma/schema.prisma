generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  password          String
  reviews           Review[]
  savedColleges     SavedCollege[]
  savedComparisons  SavedComparison[]
  createdAt         DateTime          @default(now())
}

model College {
  id             String         @id @default(cuid())
  name           String
  location       String
  fees           Int
  rating         Float
  overview       String
  placements     String

  courses        Course[]
  reviews        Review[]
  savedBy        SavedCollege[]

  createdAt      DateTime @default(now())
}

model Course {
  id          String   @id @default(cuid())
  name        String
  duration    String
  fees        Int

  collegeId   String
  college     College @relation(fields: [collegeId], references: [id])

  createdAt   DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  rating      Int
  comment     String

  userId      String
  collegeId   String

  user        User    @relation(fields: [userId], references: [id])
  college     College @relation(fields: [collegeId], references: [id])

  createdAt   DateTime @default(now())
}

model SavedCollege {
  id          String   @id @default(cuid())

  userId      String
  collegeId   String

  user        User    @relation(fields: [userId], references: [id])
  college     College @relation(fields: [collegeId], references: [id])

  createdAt   DateTime @default(now())
}

model SavedComparison {
  id          String   @id @default(cuid())

  userId      String
  collegeIds  String

  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}